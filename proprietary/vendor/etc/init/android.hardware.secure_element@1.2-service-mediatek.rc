service mtk_secure_element_hal_service /vendor/bin/hw/android.hardware.secure_element@1.2-service-mediatek
    class hal
    user secure_element
    group secure_element
    disabled


on boot && property:ro.boot.product.hardware.sku=p15apg
    start mtk_secure_element_hal_service

on boot && property:ro.boot.product.hardware.sku=p15ape
    start mtk_secure_element_hal_service

on boot && property:ro.boot.product.hardware.sku=p15ae
    start mtk_secure_element_hal_service

on boot && property:ro.boot.product.hardware.sku=p15aer
    start mtk_secure_element_hal_service
